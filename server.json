{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mordechaipotash/brain-mcp",
  "title": "brain \u2014 the recorder",
  "description": "Records your Claude Code, Codex and Pi history before deletion. Cited-or-abstain recall.",
  "version": "2.0.0",
  "repository": {
    "url": "https://github.com/mordechaipotash/brain-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "brain-mcp",
      "version": "2.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "BRAIN_HOME",
          "description": "Data directory for the floor (default ~/.brain)",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ]
}